{
  "buildCommand": "cd frontend && npm run build",
  "devCommand": "cd frontend && npm run dev",
  "installCommand": "cd frontend && npm install && pip install -r requirements.txt",
  "framework": "nextjs",
  "outputDirectory": "frontend/.next",
  "functions": {
    "frontend/api/*.py": {
      "runtime": "python3.12",
      "maxDuration": 30,
      "memory": 1024
    }
  }
}